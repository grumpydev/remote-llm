[Unit]
Description=Authenticated AI appliance Wake-on-LAN relay
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=ai-power-relay
Group=ai-power-relay
EnvironmentFile=/etc/ai-power-relay/relay.env
Environment=PYTHONPATH=/opt/ai-power-relay
ExecStart=/opt/ai-power-relay/run-power-relay
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
