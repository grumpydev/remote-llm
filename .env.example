# Copy to .env through scripts/install. The installer replaces every CHANGE_ME.
COMPOSE_PROJECT_NAME=ai-appliance
AI_ADMIN_USER=CHANGE_ME
AI_HOSTNAME=CHANGE_ME
TAILSCALE_IP=CHANGE_ME
LITELLM_PORT=4000
OPEN_WEBUI_PORT=3000
LITELLM_MASTER_KEY=CHANGE_ME
LLAMA_API_KEY=CHANGE_ME
WEBUI_SECRET_KEY=CHANGE_ME
SEARXNG_SECRET_KEY=CHANGE_ME
OPEN_WEBUI_VOLUME=open-webui-data
AI_JOBS_ROOT=/srv/ai-jobs
AI_SECRETS_DIR=/etc/ai-appliance
AI_APPLIANCE_GID=999
JOB_CPU_LIMIT=12
JOB_MEMORY_LIMIT=24g
