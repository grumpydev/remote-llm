#!/usr/bin/env bash
set -Eeuo pipefail
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd)"
cd "${ROOT}"

usage() {
	printf 'Usage: scripts/test [--require-tools]\n'
}
require_tools=false
case "${1:-}" in
--require-tools) require_tools=true ;;
-h | --help)
	usage
	exit 0
	;;
"") ;;
*)
	usage >&2
	exit 2
	;;
esac

shell_files=()
bash_files=()
sh_files=()
while IFS= read -r file; do
	first="$(head -n1 "${file}")"
	case "${first}" in
	*bash)
		shell_files+=("${file}")
		bash_files+=("${file}")
		;;
	*"/sh")
		shell_files+=("${file}")
		sh_files+=("${file}")
		;;
	esac
done < <(find scripts docker/opencode-worker -type f \( -name '*.sh' -o -perm -u+x \) -print | sort)
((${#bash_files[@]} == 0)) || bash -n "${bash_files[@]}"
for file in "${sh_files[@]}"; do sh -n "${file}"; done

missing=0
if command -v shellcheck >/dev/null 2>&1; then
	shellcheck "${shell_files[@]}"
else
	printf 'SKIP: shellcheck is not installed.\n'
	missing=1
fi
if command -v shfmt >/dev/null 2>&1; then
	shfmt -d "${shell_files[@]}"
else
	printf 'SKIP: shfmt is not installed.\n'
	missing=1
fi
if "${require_tools}" && ((missing)); then
	printf 'ERROR: required static tools are missing.\n' >&2
	exit 1
fi

python3 -m compileall -q ai_appliance tests
python3 -m json.tool schemas/job.schema.json >/dev/null
python3 -m unittest discover -s tests -v

test_env="$(mktemp)"
runtime_dir="$(mktemp -d)"
compose_override="$(mktemp)"
router_catalogue="$(mktemp)"
router_preset="$(mktemp)"
routing_registry="$(mktemp)"
routing_yaml="$(mktemp)"
trap 'rm -f -- "${test_env}" "${compose_override}" "${router_catalogue}" "${router_preset}" "${routing_registry}" "${routing_yaml}"; rm -rf -- "${runtime_dir}"' EXIT
sed \
	-e 's/^TAILSCALE_IP=.*/TAILSCALE_IP=100.64.0.10/' \
	-e 's/CHANGE_ME/0123456789abcdef0123456789abcdef/g' \
	.env.example >"${test_env}"
scripts/render-config --env-file "${test_env}" --output "${runtime_dir}"
grep -q '^LLAMA_API_KEY=' "${runtime_dir}/litellm/provider.env"
python3 -m json.tool "${runtime_dir}/opencode/opencode.json" >/dev/null
grep -q '"glm-4.7-flash"' "${runtime_dir}/opencode/opencode.json"
[[ "$(stat -c '%a' "${runtime_dir}/opencode/opencode.json" 2>/dev/null ||
	stat -f '%Lp' "${runtime_dir}/opencode/opencode.json")" == 644 ]]
[[ "$(stat -c '%a' "${runtime_dir}/searxng/settings.yml" 2>/dev/null ||
	stat -f '%Lp' "${runtime_dir}/searxng/settings.yml")" == 600 ]]
if [[ "${EUID}" -eq 0 ]]; then
	[[ "$(stat -c '%u:%g' "${runtime_dir}/searxng/settings.yml")" == 977:977 ]]
	[[ "$(stat -c '%a' "${runtime_dir}/searxng")" == 700 ]]
fi
if grep -qE 'LITELLM_MASTER_KEY|WEBUI_SECRET_KEY|SEARXNG_SECRET_KEY' \
	"${runtime_dir}/litellm/provider.env"; then
	printf 'ERROR: unrelated secret leaked into provider environment.\n' >&2
	exit 1
fi
{
	printf 'services:\n'
	printf '  litellm:\n'
	printf '    env_file: !override\n'
	printf '      - %s\n' "${runtime_dir}/litellm/provider.env"
} >"${compose_override}"
docker compose --env-file versions.env --env-file "${test_env}" \
	-f compose.yaml -f compose.worker.yaml -f "${compose_override}" \
	--profile worker config --quiet

cp config/llama/models.json "${router_catalogue}"
scripts/router-config --catalogue "${router_catalogue}" \
	add --alias test-coder --source example/test-coder-GGUF:Q4_K_M \
	--display-name "Test Coder" --context 8192 --output-tokens 2048 >/dev/null
scripts/router-config --catalogue "${router_catalogue}" \
	--output "${router_preset}" render
grep -q '^\[test-coder\]$' "${router_preset}"
grep -q '^hf-repo = example/test-coder-GGUF:Q4_K_M$' "${router_preset}"
grep -q '^ctx-size = 8192$' "${router_preset}"
scripts/router-config --catalogue "${router_catalogue}" \
	remove --alias test-coder >/dev/null
if scripts/router-config --catalogue "${router_catalogue}" \
	remove --alias glm-4.7-flash >/dev/null 2>&1; then
	printf 'ERROR: router allowed removal of the default model.\n' >&2
	exit 1
fi
if scripts/router-config --catalogue "${router_catalogue}" \
	add --alias unsafe --source ../model:Q4_K_M >/dev/null 2>&1; then
	printf 'ERROR: router accepted an unsafe model source.\n' >&2
	exit 1
fi

cp config/litellm/models.json "${routing_registry}"
scripts/model-config --registry "${routing_registry}" --output "${routing_yaml}" \
	add --alias test-coder \
	--provider-model openai/example/test-coder-GGUF:Q4_K_M \
	--api-base http://host.docker.internal:8080/v1 \
	--api-key-env LLAMA_API_KEY \
	--display-name "Test Coder" --context 8192 --output-tokens 2048 >/dev/null
grep -q 'model_name: "test-coder"' "${routing_yaml}"
python3 -c \
	"import json,sys; model=next(x for x in json.load(open(sys.argv[1])) if x['alias']=='test-coder'); assert model['output']==2048" \
	"${routing_registry}"

grep -q 'http://127.0.0.1:8080/healthz' compose.yaml
if rg -n 'healthcheck:|test:' compose.yaml -A2 |
	grep -q '/search?'; then
	printf 'ERROR: health checks must not depend on live search engines.\n' >&2
	exit 1
fi
grep -q '^[[:space:]]*limiter: false$' config/searxng/settings.yml.template
grep -q 'compose up -d --force-recreate searxng' scripts/install
grep -q 'compose up -d --wait --wait-timeout 300 open-webui' scripts/install
grep -q "comment 'AI appliance to llama.cpp'" scripts/install
grep -q -- '--fresh-open-webui' scripts/migrate
grep -q -- "--open-webui-volume \"\${preserved_volume}\"" scripts/migrate
grep -q '^[[:space:]]*- DAC_READ_SEARCH$' compose.yaml
grep -q 'BYPASS_WEB_SEARCH_WEB_LOADER: "true"' compose.yaml
grep -q 'worker_compose --profile worker run -T --rm --no-deps' scripts/doctor
grep -q 'LiteLLM authenticated chat completion' scripts/doctor
grep -q 'AI_MODEL_READY_TIMEOUT:-900' scripts/doctor
grep -q 'AI_MODEL_READY_TIMEOUT=900' scripts/install-power-relay
grep -q -- '--models-max 1' native/run-llama-router
grep -q 'router_help=' scripts/ai-model
grep -q 'ln -sfn.*ai-model' scripts/install
grep -q 'ln -sfn.*ai-opencode' scripts/install
grep -q 'ai-rotate-litellm-key' scripts/install
grep -q 'new key validation failed; restoring the previous key' \
	scripts/rotate-litellm-key
grep -q -- '--user' scripts/ai-opencode
grep -q 'SUDO_UID' scripts/ai-opencode
grep -q 'Wake-on-LAN enabled' scripts/enable-wol
grep -q 'restrict,command=' scripts/authorize-power-relay
grep -q 'mktemp.*authorized' scripts/authorize-power-relay
grep -q 'mv -f.*temporary.*authorized' scripts/authorize-power-relay
grep -q 'tailscale serve --bg --tcp 2222 22' scripts/authorize-power-relay
grep -q 'AI_RELAY_LISTEN_HOST' scripts/install-power-relay
grep -q '^- AI Appliance:' scripts/install-power-relay
grep -q 'BEGIN AI APPLIANCE POWER' scripts/install-homepage-widget
grep -q 'refusing symlink services file' scripts/install-homepage-widget
grep -q 'Homepage to AI power relay' scripts/install-homepage-widget
grep -q 'Homepage container reaches' scripts/install-homepage-widget
grep -q "write-out.*\\\\n" scripts/power-client
grep -q 'model readiness probe active' scripts/power-client
grep -q 'AI_SHUTDOWN_SSH_PORT=' scripts/install-power-relay
grep -q 'install -d -m 0755 -o root -g root /opt/ai-power-relay' \
	scripts/install-power-relay
grep -q 'for _ in {1..20}' scripts/install-power-relay
grep -q '^ExecStart=/usr/bin/python3 -m ai_appliance.power_relay$' \
	systemd/ai-power-relay.service
grep -q 'source.*relay' scripts/poweroff-when-idle

if rg -n 'image:.*:(latest|main)([[:space:]]|$)' compose.yaml compose.worker.yaml; then
	printf 'ERROR: moving image tag found.\n' >&2
	exit 1
fi
private_identity_pattern='srdesktop''-llm|home-''nuc|sro''bbins|Simon'' Robbins|/Users/sro''bbins'
if rg -n -i "${private_identity_pattern}" --glob '!.git/**' .; then
	printf 'ERROR: private build-specific identity found in the public tree.\n' >&2
	exit 1
fi
git diff --check
printf 'All available tests passed.\n'
