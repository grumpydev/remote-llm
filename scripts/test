#!/usr/bin/env bash
set -Eeuo pipefail
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd)"
cd "${ROOT}"

usage() {
	printf 'Usage: scripts/test [--require-tools]\n'
}
require_tools=false
case "${1:-}" in
--require-tools) require_tools=true ;;
-h | --help)
	usage
	exit 0
	;;
"") ;;
*)
	usage >&2
	exit 2
	;;
esac

shell_files=()
bash_files=()
sh_files=()
while IFS= read -r file; do
	first="$(head -n1 "${file}")"
	case "${first}" in
	*bash)
		shell_files+=("${file}")
		bash_files+=("${file}")
		;;
	*"/sh")
		shell_files+=("${file}")
		sh_files+=("${file}")
		;;
	esac
done < <(find scripts docker/opencode-worker -type f \( -name '*.sh' -o -perm -u+x \) -print | sort)
((${#bash_files[@]} == 0)) || bash -n "${bash_files[@]}"
for file in "${sh_files[@]}"; do sh -n "${file}"; done

missing=0
if command -v shellcheck >/dev/null 2>&1; then
	shellcheck "${shell_files[@]}"
else
	printf 'SKIP: shellcheck is not installed.\n'
	missing=1
fi
if command -v shfmt >/dev/null 2>&1; then
	shfmt -d "${shell_files[@]}"
else
	printf 'SKIP: shfmt is not installed.\n'
	missing=1
fi
if "${require_tools}" && ((missing)); then
	printf 'ERROR: required static tools are missing.\n' >&2
	exit 1
fi

python3 -m compileall -q ai_appliance tests
python3 -m json.tool schemas/job.schema.json >/dev/null
python3 -m unittest discover -s tests -v

test_env="$(mktemp)"
runtime_dir="$(mktemp -d)"
compose_override="$(mktemp)"
trap 'rm -f -- "${test_env}" "${compose_override}"; rm -rf -- "${runtime_dir}"' EXIT
sed \
	-e 's/^TAILSCALE_IP=.*/TAILSCALE_IP=100.64.0.10/' \
	-e 's/CHANGE_ME/0123456789abcdef0123456789abcdef/g' \
	.env.example >"${test_env}"
scripts/render-config --env-file "${test_env}" --output "${runtime_dir}"
grep -q '^LLAMA_API_KEY=' "${runtime_dir}/litellm/provider.env"
[[ "$(stat -c '%a' "${runtime_dir}/searxng/settings.yml" 2>/dev/null ||
	stat -f '%Lp' "${runtime_dir}/searxng/settings.yml")" == 600 ]]
if [[ "${EUID}" -eq 0 ]]; then
	[[ "$(stat -c '%u:%g' "${runtime_dir}/searxng/settings.yml")" == 977:977 ]]
	[[ "$(stat -c '%a' "${runtime_dir}/searxng")" == 700 ]]
fi
if grep -qE 'LITELLM_MASTER_KEY|WEBUI_SECRET_KEY|SEARXNG_SECRET_KEY' \
	"${runtime_dir}/litellm/provider.env"; then
	printf 'ERROR: unrelated secret leaked into provider environment.\n' >&2
	exit 1
fi
{
	printf 'services:\n'
	printf '  litellm:\n'
	printf '    env_file: !override\n'
	printf '      - %s\n' "${runtime_dir}/litellm/provider.env"
} >"${compose_override}"
docker compose --env-file versions.env --env-file "${test_env}" \
	-f compose.yaml -f compose.worker.yaml -f "${compose_override}" \
	--profile worker config --quiet

grep -q 'http://127.0.0.1:8080/healthz' compose.yaml
if rg -n 'healthcheck:|test:' compose.yaml -A2 |
	grep -q '/search?'; then
	printf 'ERROR: health checks must not depend on live search engines.\n' >&2
	exit 1
fi
grep -q '^[[:space:]]*limiter: false$' config/searxng/settings.yml.template
grep -q 'compose up -d --force-recreate searxng' scripts/install
grep -q 'compose up -d --wait --wait-timeout 300 open-webui' scripts/install
grep -q '^[[:space:]]*- DAC_READ_SEARCH$' compose.yaml
grep -q 'worker_compose --profile worker run -T --rm --no-deps' scripts/doctor

if rg -n 'image:.*:(latest|main)([[:space:]]|$)' compose.yaml compose.worker.yaml; then
	printf 'ERROR: moving image tag found.\n' >&2
	exit 1
fi
private_identity_pattern='srdesktop''-llm|sro''bbins|Simon'' Robbins|/Users/sro''bbins'
if rg -n -i "${private_identity_pattern}" --glob '!.git/**' .; then
	printf 'ERROR: private build-specific identity found in the public tree.\n' >&2
	exit 1
fi
git diff --check
printf 'All available tests passed.\n'
