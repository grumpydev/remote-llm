#!/usr/bin/env bash
set -Eeuo pipefail
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/_common.sh
source "${SCRIPT_DIR}/_common.sh"

usage() {
	cat <<'EOF'
Usage: sudo scripts/install-homepage-widget [--services-file PATH]
                                             [--container NAME]

Install or replace the managed AI appliance power block in Homepage without
printing its bearer token. The existing services file is backed up first.
EOF
}

services_file=/opt/homepage/config/services.yaml
container=homepage
while (($#)); do
	case "$1" in
	--services-file)
		shift
		services_file="${1:-}"
		;;
	--container)
		shift
		container="${1:-}"
		;;
	-h | --help)
		usage
		exit 0
		;;
	*) die "unknown argument: $1" ;;
	esac
	shift
done

require_root
require_command docker
require_command python3
[[ "${services_file}" == /* ]] || die "--services-file must be absolute"
[[ "${container}" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$ ]] ||
	die "unsafe container name"
[[ ! -L "${services_file}" ]] || die "refusing symlink services file"
[[ -f "${services_file}" ]] || die "Homepage services file not found: ${services_file}"
snippet=/etc/ai-power-relay/homepage-services.yaml
[[ -r "${snippet}" ]] || die "generated Homepage snippet is unreadable"
grep -q '^- AI Appliance:$' "${snippet}" ||
	die "generated snippet is stale; rerun scripts/install-power-relay"
docker inspect "${container}" >/dev/null 2>&1 || die "Homepage container not found"

client_config=/etc/ai-power-relay/client.env
[[ -r "${client_config}" ]] || die "power relay client configuration is unreadable"
# shellcheck disable=SC1090
source "${client_config}"
relay_authority="${AI_RELAY_URL#http://}"
relay_host="${relay_authority%%:*}"
relay_port="${relay_authority##*:}"
python3 - "${relay_host}" "${relay_port}" <<'PY'
import ipaddress
import sys

address = ipaddress.ip_address(sys.argv[1])
port = int(sys.argv[2])
if address not in ipaddress.ip_network("100.64.0.0/10") or not 1024 <= port <= 65535:
    raise SystemExit("unsafe relay address or port")
PY

if command -v ufw >/dev/null 2>&1 && ufw status | grep -q '^Status: active'; then
	mapfile -t homepage_networks < <(
		docker inspect -f \
			'{{range $name, $_ := .NetworkSettings.Networks}}{{println $name}}{{end}}' \
			"${container}"
	)
	((${#homepage_networks[@]})) || die "Homepage has no Docker network"
	for network in "${homepage_networks[@]}"; do
		[[ -n "${network}" ]] || continue
		[[ "$(docker network inspect -f '{{.Driver}}' "${network}")" == bridge ]] || continue
		bridge="$(docker network inspect -f \
			'{{index .Options "com.docker.network.bridge.name"}}' "${network}")"
		if [[ -z "${bridge}" || "${bridge}" == '<no value>' ]]; then
			if [[ "${network}" == bridge ]]; then
				bridge=docker0
			else
				network_id="$(docker network inspect -f '{{.Id}}' "${network}")"
				bridge="br-${network_id:0:12}"
			fi
		fi
		subnet="$(docker network inspect -f \
			'{{range .IPAM.Config}}{{if .Subnet}}{{println .Subnet}}{{end}}{{end}}' \
			"${network}" | head -n1)"
		[[ "${bridge}" =~ ^[A-Za-z0-9_.:-]{1,32}$ && -n "${subnet}" ]] ||
			die "could not resolve Homepage bridge details"
		python3 -c 'import ipaddress,sys; assert ipaddress.ip_network(sys.argv[1]).version == 4' \
			"${subnet}"
		if ! ufw status | grep -F "${relay_port}/tcp" |
			grep -F "${bridge}" |
			grep -qF 'Homepage to AI power relay'; then
			ufw allow in on "${bridge}" from "${subnet}" to "${relay_host}" \
				port "${relay_port}" proto tcp \
				comment 'Homepage to AI power relay'
		fi
	done
fi

backup="${services_file}.ai-appliance.$(date -u +%Y%m%dT%H%M%SZ).bak"
result="$(
	python3 - "${services_file}" "${snippet}" "${backup}" <<'PY'
import os
import shutil
import sys
import tempfile
from pathlib import Path

target = Path(sys.argv[1])
snippet = Path(sys.argv[2]).read_text(encoding="utf-8").strip()
backup = Path(sys.argv[3])
begin = "# BEGIN AI APPLIANCE POWER (managed)"
end = "# END AI APPLIANCE POWER (managed)"
original = target.read_text(encoding="utf-8")

has_begin = begin in original
has_end = end in original
if has_begin != has_end:
    raise SystemExit("managed Homepage markers are incomplete; restore or remove them")
if original.count(begin) > 1 or original.count(end) > 1:
    raise SystemExit("multiple managed Homepage blocks found")

remaining = original
if has_begin:
    start = original.index(begin)
    finish = original.index(end, start) + len(end)
    remaining = original[:start].rstrip() + "\n\n" + original[finish:].lstrip("\n")

block = f"{begin}\n{snippet}\n{end}"
updated = remaining.rstrip()
if updated:
    updated += "\n\n"
updated += block + "\n"
if updated == original:
    print("unchanged")
    raise SystemExit(0)

shutil.copy2(target, backup)
metadata = target.stat()
fd, temporary_name = tempfile.mkstemp(prefix="services.", dir=target.parent)
try:
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
        handle.write(updated)
        handle.flush()
        os.fsync(handle.fileno())
    os.chmod(temporary_name, metadata.st_mode & 0o777)
    os.chown(temporary_name, metadata.st_uid, metadata.st_gid)
    os.replace(temporary_name, target)
finally:
    if os.path.exists(temporary_name):
        os.unlink(temporary_name)
print("changed")
PY
)"

if [[ "${result}" == changed ]]; then
	docker restart "${container}" >/dev/null
	homepage_running=false
	for _ in {1..30}; do
		if [[ "$(docker inspect -f '{{.State.Running}}' "${container}")" == true ]]; then
			homepage_running=true
			break
		fi
		sleep 1
	done
	"${homepage_running}" || die "Homepage did not restart; backup retained at ${backup}"
	printf 'Homepage power widget installed. Backup: %s\n' "${backup}"
else
	printf 'Homepage power widget already current; no restart needed.\n'
fi

relay_reachable=false
for _ in {1..15}; do
	if docker exec "${container}" node -e \
		'fetch(process.argv[1]).then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))' \
		"${AI_RELAY_URL}/healthz"; then
		relay_reachable=true
		break
	fi
	sleep 1
done
"${relay_reachable}" ||
	die "Homepage cannot reach the relay; check its Docker bridge firewall rule"
printf 'Homepage container reaches the authenticated power relay.\n'
