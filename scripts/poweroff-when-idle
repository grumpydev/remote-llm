#!/usr/bin/env bash
set -Eeuo pipefail
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/_common.sh
source "${SCRIPT_DIR}/_common.sh"

usage() {
	cat <<'EOF'
Usage: sudo scripts/poweroff-when-idle [--dry-run]

Honor a batch-worker or authenticated relay shutdown request only after its
delay, when no job is running and no inhibit file exists. Batch requests also
require terminal metadata and a successful required push.
EOF
}
dry_run=false
case "${1:-}" in
--dry-run) dry_run=true ;;
-h | --help)
	usage
	exit 0
	;;
"") ;;
*) die "unknown argument: $1" ;;
esac
require_root
jobs_root="${AI_JOBS_ROOT:-/srv/ai-jobs}"
request="${jobs_root}/shutdown.request"
[[ -f "${request}" ]] || exit 0
[[ ! -e "${SECRETS_DIR}/no-poweroff" ]] || {
	log "Shutdown inhibited by ${SECRETS_DIR}/no-poweroff"
	exit 0
}
if find "${jobs_root}/running" -mindepth 1 -maxdepth 1 -type d -print -quit | grep -q .; then
	log "Shutdown deferred: a job is running."
	exit 0
fi

read_request="$(
	PYTHONPATH="${DEPLOY_DIR}" python3 - "${request}" <<'PY'
import json
import re
import sys
from pathlib import Path

value = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
job_id = value.get("job_id")
state = value.get("state")
not_before = value.get("not_before_epoch")
source = value.get("source", "batch")
if source not in {"batch", "relay", "manual"} or not isinstance(not_before, int):
    raise SystemExit("invalid shutdown request")
if source == "batch":
    if not isinstance(job_id, str) or not re.fullmatch(r"[a-z0-9][a-z0-9-]{0,62}", job_id):
        raise SystemExit("invalid shutdown job ID")
    if state not in {"completed", "failed", "cancelled"}:
        raise SystemExit("invalid shutdown state")
else:
    job_id, state = "-", "-"
print(source, job_id, state, not_before)
PY
)"
read -r request_source job_id state not_before <<<"${read_request}"
now="$(date +%s)"
((now >= not_before)) || {
	log "Shutdown deferred until epoch ${not_before}."
	exit 0
}
if [[ "${request_source}" == batch ]]; then
	metadata="${jobs_root}/${state}/${job_id}/metadata.json"
	[[ -f "${metadata}" ]] || die "shutdown metadata missing: ${metadata}"
	python3 - "${metadata}" "${state}" <<'PY'
import json
import sys
from pathlib import Path

value = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
if value.get("state") != sys.argv[2] or not value.get("shutdown", {}).get("requested"):
    raise SystemExit("metadata does not authorize shutdown")
if value.get("push", {}).get("requested") and not value.get("push", {}).get("succeeded"):
    raise SystemExit("required push did not succeed")
PY
	request_description="batch job ${job_id}"
else
	request_description="${request_source} request"
fi

if "${dry_run}"; then
	log "DRY RUN: would flush filesystems and power off for ${request_description}."
	exit 0
fi
rm -f -- "${request}"
sync
logger -t ai-appliance "Powering off after ${request_description}"
systemctl poweroff
