#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/_common.sh
source "${SCRIPT_DIR}/_common.sh"

usage() {
	cat <<'EOF'
Usage: sudo scripts/install [--dry-run] [--deploy-dir PATH] [--admin-user USER]

Install or reconcile the appliance without deleting existing data. Generates
missing secrets, detects Tailscale, creates the external Open WebUI volume,
renders configuration, starts services in order, and validates the live stack.
EOF
}

dry_run=false
admin_user="${AI_ADMIN_USER:-}"
while (($#)); do
	case "$1" in
	--dry-run) dry_run=true ;;
	--deploy-dir)
		shift
		[[ $# -gt 0 ]] || die "--deploy-dir needs a path"
		DEPLOY_DIR="$1"
		;;
	--admin-user)
		shift
		[[ $# -gt 0 ]] || die "--admin-user needs a username"
		admin_user="$1"
		;;
	-h | --help)
		usage
		exit 0
		;;
	*) die "unknown argument: $1" ;;
	esac
	shift
done

require_root
require_command docker
require_command ss
docker compose version >/dev/null
tailscale_ip="$(detect_tailscale_ip)"
appliance_hostname="$(hostname -s)"
[[ "${appliance_hostname}" =~ ^[A-Za-z0-9][A-Za-z0-9.-]{0,252}$ ]] ||
	die "hostname is unsafe; set a conventional hostname before installing"
if [[ -z "${admin_user}" && -n ${SUDO_USER:-} && ${SUDO_USER} != root ]]; then
	admin_user="${SUDO_USER}"
fi
if [[ -z "${admin_user}" ]]; then
	repository_owner="$(stat -c '%U' "${REPO_ROOT}" 2>/dev/null || true)"
	if [[ -n "${repository_owner}" && "${repository_owner}" != root ]]; then
		admin_user="${repository_owner}"
	fi
fi
[[ "${admin_user}" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] ||
	die "could not detect a safe administrator account; use --admin-user USER"
[[ "${admin_user}" != root ]] || die "the appliance administrator must not be root"
getent passwd "${admin_user}" >/dev/null 2>&1 ||
	die "administrator account does not exist: ${admin_user}"

if "${dry_run}"; then
	log "DRY RUN: deploy ${REPO_ROOT} to ${DEPLOY_DIR}"
	log "DRY RUN: grant appliance operator access to ${admin_user}"
	log "DRY RUN: record server hostname ${appliance_hostname}"
	log "DRY RUN: bind services to 127.0.0.1 and ${tailscale_ip}"
	log "DRY RUN: create/preserve Open WebUI volume, render, start, validate"
	exit 0
fi

getent group ai-appliance >/dev/null 2>&1 || groupadd --system ai-appliance
appliance_gid="$(getent group ai-appliance | cut -d: -f3)"
[[ "${appliance_gid}" =~ ^[0-9]+$ ]] || die "could not resolve ai-appliance group ID"
usermod -a -G ai-appliance "${admin_user}"
install -d -m 0755 "${DEPLOY_DIR}"
install -d -m 0750 -g ai-appliance "${SECRETS_DIR}"
preserved_models=""
if [[ -f "${DEPLOY_DIR}/config/litellm/models.json" ]]; then
	preserved_models="$(mktemp)"
	cp "${DEPLOY_DIR}/config/litellm/models.json" "${preserved_models}"
fi
tar --exclude=.git --exclude=.env --exclude=runtime -C "${REPO_ROOT}" -cf - . |
	tar -C "${DEPLOY_DIR}" -xf -
if [[ -n "${preserved_models}" ]]; then
	install -m 0644 "${preserved_models}" "${DEPLOY_DIR}/config/litellm/models.json"
	rm -f -- "${preserved_models}"
fi

env_file="${DEPLOY_DIR}/.env"
if [[ ! -f "${env_file}" ]]; then
	litellm_key="sk-$(random_secret)"
	llama_key_file="/etc/llama-server.api-key"
	[[ -r "${llama_key_file}" ]] ||
		die "cannot read ${llama_key_file}; grant root read access before installing"
	llama_key="$(tr -d '\r\n' <"${llama_key_file}")"
	[[ -n "${llama_key}" ]] || die "${llama_key_file} is empty"
	{
		printf 'COMPOSE_PROJECT_NAME=ai-appliance\n'
		printf 'AI_ADMIN_USER=%s\n' "${admin_user}"
		printf 'AI_HOSTNAME=%s\n' "${appliance_hostname}"
		printf 'TAILSCALE_IP=%s\n' "${tailscale_ip}"
		printf 'LITELLM_PORT=4000\nOPEN_WEBUI_PORT=3000\n'
		printf 'LITELLM_MASTER_KEY=%s\n' "${litellm_key}"
		printf 'LLAMA_API_KEY=%s\n' "${llama_key}"
		printf 'WEBUI_SECRET_KEY=%s\n' "$(random_secret)"
		printf 'SEARXNG_SECRET_KEY=%s\n' "$(random_secret)"
		printf 'OPEN_WEBUI_VOLUME=open-webui-data\n'
		printf 'AI_JOBS_ROOT=/srv/ai-jobs\nAI_SECRETS_DIR=%s\n' "${SECRETS_DIR}"
		printf 'AI_APPLIANCE_GID=%s\n' "${appliance_gid}"
		printf 'JOB_CPU_LIMIT=12\nJOB_MEMORY_LIMIT=24g\n'
	} | atomic_write "${env_file}" 0600
else
	sed -i.bak -E "s/^TAILSCALE_IP=.*/TAILSCALE_IP=${tailscale_ip}/" "${env_file}"
	for setting in \
		"AI_ADMIN_USER=${admin_user}" \
		"AI_HOSTNAME=${appliance_hostname}"; do
		key="${setting%%=*}"
		if grep -q "^${key}=" "${env_file}"; then
			sed -i.bak -E "s/^${key}=.*/${setting}/" "${env_file}"
		else
			printf '%s\n' "${setting}" >>"${env_file}"
		fi
	done
	if grep -q '^AI_APPLIANCE_GID=' "${env_file}"; then
		sed -i.bak -E "s/^AI_APPLIANCE_GID=.*/AI_APPLIANCE_GID=${appliance_gid}/" "${env_file}"
	else
		printf 'AI_APPLIANCE_GID=%s\n' "${appliance_gid}" >>"${env_file}"
	fi
	chmod 0600 "${env_file}"
fi
chgrp ai-appliance "${env_file}"
chmod 0640 "${env_file}"

install -d -m 0750 "${DEPLOY_DIR}/runtime"
"${DEPLOY_DIR}/scripts/render-config" --env-file "${env_file}" \
	--output "${DEPLOY_DIR}/runtime"

volume="$(sed -n 's/^OPEN_WEBUI_VOLUME=//p' "${env_file}")"
[[ "${volume}" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] || die "unsafe volume name"
docker volume inspect "${volume}" >/dev/null 2>&1 || docker volume create "${volume}" >/dev/null

jobs_root="$(sed -n 's/^AI_JOBS_ROOT=//p' "${env_file}")"
[[ "${jobs_root}" == /srv/* ]] || die "AI_JOBS_ROOT must be under /srv"
for directory in queue running completed failed cancelled workspaces shared-cache; do
	install -d -m 0750 "${jobs_root}/${directory}"
done
chown 1000:1000 "${jobs_root}/shared-cache"
if [[ ! -f "${SECRETS_DIR}/repositories.allow" ]]; then
	{
		printf '# One exact URL or shell glob per line. Add only repositories this worker may clone.\n'
		printf '# git@github.com:owner/repository.git\n'
	} | atomic_write "${SECRETS_DIR}/repositories.allow" 0640
fi
if [[ ! -f "${SECRETS_DIR}/checks.allow" ]]; then
	{
		printf '# Trusted command globs. Repository scripts still execute untrusted code.\n'
		printf 'npm test*\nnpm run lint*\nnpm run typecheck*\n'
		printf 'make test*\npytest*\ncargo test*\ngo test*\n'
	} | atomic_write "${SECRETS_DIR}/checks.allow" 0640
fi
if [[ ! -f "${SECRETS_DIR}/known_hosts" ]]; then
	install -m 0640 /dev/null "${SECRETS_DIR}/known_hosts"
fi
if [[ ! -f "${SECRETS_DIR}/git_deploy_key" ]]; then
	install -m 0600 /dev/null "${SECRETS_DIR}/git_deploy_key"
fi
chgrp ai-appliance \
	"${SECRETS_DIR}/repositories.allow" \
	"${SECRETS_DIR}/checks.allow" \
	"${SECRETS_DIR}/known_hosts" \
	"${SECRETS_DIR}/git_deploy_key"
chmod 0640 \
	"${SECRETS_DIR}/repositories.allow" \
	"${SECRETS_DIR}/checks.allow" \
	"${SECRETS_DIR}/known_hosts" \
	"${SECRETS_DIR}/git_deploy_key"
install -m 0644 "${DEPLOY_DIR}/systemd/ai-batch-worker.service" /etc/systemd/system/
install -m 0644 "${DEPLOY_DIR}/systemd/ai-batch-worker.path" /etc/systemd/system/
install -m 0644 "${DEPLOY_DIR}/systemd/ai-poweroff-check.service" /etc/systemd/system/
install -m 0644 "${DEPLOY_DIR}/systemd/ai-poweroff-check.timer" /etc/systemd/system/
systemctl daemon-reload
systemctl enable --now ai-batch-worker.path ai-poweroff-check.timer

compose config --quiet
worker_compose --profile worker config --quiet
litellm_port="$(sed -n 's/^LITELLM_PORT=//p' "${env_file}")"
webui_port="$(sed -n 's/^OPEN_WEBUI_PORT=//p' "${env_file}")"
for service_port in "litellm:${litellm_port}" "open-webui:${webui_port}"; do
	service="${service_port%%:*}"
	port="${service_port##*:}"
	if ss -H -ltn "sport = :${port}" 2>/dev/null | grep -q . &&
		! compose ps --status running --services 2>/dev/null | grep -qx "${service}"; then
		ss -ltnp "sport = :${port}" >&2 || true
		die "TCP port ${port} is already in use by a process outside this appliance"
	fi
done
compose up -d searxng
compose up -d litellm
compose up -d open-webui
worker_compose --profile worker build opencode-worker
validate_deployment

if command -v ufw >/dev/null 2>&1 && ufw status | grep -q '^Status: active'; then
	ufw status | grep -qE '3000/tcp.*tailscale0' ||
		ufw allow in on tailscale0 to any port 3000 proto tcp comment 'AI appliance Open WebUI'
	ufw status | grep -qE '4000/tcp.*tailscale0' ||
		ufw allow in on tailscale0 to any port 4000 proto tcp comment 'AI appliance LiteLLM'
fi

log "Installed and validated."
log "LiteLLM: http://${tailscale_ip}:4000/v1"
log "Open WebUI: http://${tailscale_ip}:3000"
log "Retrieve the LiteLLM key with: sudo sed -n 's/^LITELLM_MASTER_KEY=//p' ${env_file}"
