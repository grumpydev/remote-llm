#!/usr/bin/env bash
set -Eeuo pipefail
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/_common.sh
source "${SCRIPT_DIR}/_common.sh"
if [[ ${1:-} == "-h" || ${1:-} == "--help" ]]; then
	printf 'Usage: sudo scripts/run-next-job [--dry-run]\n'
	exit 0
fi
require_root
[[ $# -le 1 && ${1:-} != "--help" ]] || die "only --dry-run is accepted"
PYTHONPATH="${DEPLOY_DIR}" AI_JOBS_ROOT="${AI_JOBS_ROOT:-/srv/ai-jobs}" \
	AI_SECRETS_DIR="${SECRETS_DIR}" AI_APPLIANCE_DIR="${DEPLOY_DIR}" \
	exec python3 -m ai_appliance.cli run-next "$@"
