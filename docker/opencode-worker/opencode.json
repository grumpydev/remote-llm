{
  "$schema": "https://opencode.ai/config.json",
  "model": "appliance/glm-4.7-flash",
  "provider": {
    "appliance": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "AI Appliance LiteLLM",
      "options": {
        "baseURL": "{env:LITELLM_BASE_URL}",
        "apiKey": "{env:LITELLM_MASTER_KEY}",
        "timeout": 900000
      },
      "models": {
        "glm-4.7-flash": {
          "name": "GLM 4.7 Flash",
          "limit": {
            "context": 65536,
            "output": 16384
          }
        }
      }
    }
  },
  "permission": {
    "*": "allow",
    "external_directory": "deny",
    "question": "deny",
    "task": "deny",
    "doom_loop": "deny"
  }
}

